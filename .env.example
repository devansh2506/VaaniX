# Website (Vercel / local Next.js)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Detection Pipeline
MODEL_SERVER_URL=http://127.0.0.1:8000
MODEL_SERVER_SECRET=your-model-server-secret

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Prevent_Scambot
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# Redirect Links & Thresholds
LINK_SIGNING_SECRET=your-link-signing-secret
EVIDENCE_RETENTION_DAYS=30
RADAR_THRESHOLD=3
AI_RISK_THRESHOLD=60

# Laptop Pipeline (voice_detection_pipeline/.env)
WHISPER_MODEL=small
VOICE_DETECTION_STUB=0
VAANIX_API_URL=http://localhost:3000
VAANIX_API_KEY=
